# ==============================================================================
# Variables de entorno — SaaS de reservas
# Copia este archivo a .env y rellena los valores.
# ==============================================================================

# --- Frontend (apps/dashboard y apps/widget) ---------------------------------
# Se exponen al navegador (por eso solo la clave PUBLISHABLE / anon, nunca la service_role).
VITE_SUPABASE_URL=https://fjpbruwczuovvynhlnzv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CKlKGvIyTSN3iUh-XkNlUw_qhuYabRs

# URL pública donde se sirve el widget (para el snippet de embebido y los enlaces
# "Mi reserva"). En local: http://localhost:5174
VITE_WIDGET_URL=http://localhost:5174

# ==============================================================================
# Secrets de Edge Functions (se configuran en Supabase, NO en el navegador).
# Se definen con:  supabase secrets set NOMBRE=valor
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.
#
# NOTA: email y WhatsApp se configuran PREFERENTEMENTE POR NEGOCIO desde el
# panel (Configuración → Integraciones). Los valores de abajo son un FALLBACK
# global opcional para negocios que no tengan sus propias credenciales.
# ==============================================================================

# --- Envío de email (Resend: https://resend.com) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado en Resend (dominio verificado o onboarding@resend.dev para pruebas)
EMAIL_FROM="Reservas <reservas@tudominio.com>"

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=EAAG...tu_token_permanente
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Nombre de la plantilla aprobada en Meta para el recordatorio de 24h
WHATSAPP_TEMPLATE_NAME=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es

# Secreto compartido para proteger el endpoint del cron de recordatorios
CRON_SECRET=genera-un-secreto-largo-aleatorio
